# 데이터베이스 설정
# 로컬: localhost, 운영: RDS 엔드포인트
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onkorea_db
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Google OAuth2 설정
# https://console.cloud.google.com/apis/credentials 에서 발급
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 운영 환경 OAuth Redirect URI (EC2 배포 시 필요)
GOOGLE_REDIRECT_URI=http://your-ec2-ip:8080/login/oauth2/code/google

# JWT Secret (256-bit 이상 권장)
JWT_SECRET=your-secret-key-for-jwt-token-generation-must-be-at-least-256-bits-long

# Swagger Server URL (운영 환경)
SERVER_URL=http://your-ec2-ip:8080

# AI 서버 설정 (수정 예정)
AI_SERVER_URL=http://localhost:5000
